      <setting name="FormBorderSize" serializeAs="String">
        <value>2</value>
      </setting>
      <setting name="Theme" serializeAs="String">
        <value>0</value>
      </setting>
    </UIAppearanceSettings>
  </userSettings>
  <connectionStrings>
    <add name="SQLite" connectionString="Data Source=|DataDirectory|\Banco.db;Version=3;DBServer=SQLite;" />
    <add name="MySQL" connectionString="Server=sibem-cps.mysql.uhserver.com;Port=3306;Database=sibem_cps;Uid=sibem_cps;Pwd=Sibem@2022;DBServer=MySQL;" />
    <add name="MySQL_SYS" connectionString="Server=sibem-adm.mysql.uhserver.com;Port=3306;Database=sibem_adm;Uid=sibem_adm;Pwd=Sibem@2022;DBServer=MySQL_SYS;" />
